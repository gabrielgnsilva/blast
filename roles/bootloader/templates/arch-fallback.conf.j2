title   Arch Linux (fallback initramfs)
linux   /vmlinuz-linux
initrd  /initramfs-linux-fallback.img
{% if blast_is_encrypted_root -%}
options cryptdevice=UUID={{ blast_partition_uuid }}:{{ blast_crypt_mapper_name }} root=UUID={{ blast_root_device_uuid }} rw zswap.enabled=0
{% else -%}
options root=UUID={{ blast_root_device_uuid }} rw zswap.enabled=0
{% endif -%}
